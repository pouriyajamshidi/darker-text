{
    "manifest_version": 3,
    "name": "Darker Text",
    "description": "Softens near-white text on dark pages, without making it hard to read",
    "version": "2.0",
    "permissions": [
        "storage"
    ],
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "action": {
        "default_title": "Darker Text",
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "darker.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://*.youtube.com/*"
            ],
            "css": [
                "youtube.css"
            ]
        }
    ]
}
